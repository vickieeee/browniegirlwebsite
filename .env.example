# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Server-side MongoDB Atlas connection string (keep secret, never prefix with VITE_).
# Set this in AI Studio Secrets panel and in Vercel Project Settings -> Environment Variables.
MONGODB_URI=""

# MONGODB_DB_NAME: Name of the MongoDB database inside your cluster.
MONGODB_DB_NAME="browniegirlcakes"

# ADMIN_SESSION_SECRET: Server-side 256-bit secret key used to sign and verify HMAC-SHA256 admin session tokens.
# Keep secret on the server (never prefix with VITE_).
ADMIN_SESSION_SECRET=""

